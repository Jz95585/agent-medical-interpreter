# LLM 服务配置（OpenRouter，OpenAI 兼容协议）
AMI_BASE_URL=https://openrouter.ai/api/v1
AMI_MODEL=deepseek/deepseek-v4.1-flash
AMI_API_KEY=sk-or-v1-xxxx

# 语音服务（硅基流动 SiliconFlow）：TTS 走 CosyVoice2，ASR 走 SenseVoice
# 未配置时前端朗读自动回退浏览器合成，语音输入不可用
SILICONFLOW_API_KEY=sk-xxxx

# 服务端口
PORT=8790

# 监听地址：默认 127.0.0.1；公网部署设 0.0.0.0（必须配合 ALLOWED_HOSTS）
BIND=127.0.0.1
# 允许的 Host 头：逗号分隔。精确写法 yourdomain.com:8790；后缀通配以 . 开头（如 .cpolar.top）；* 全放行（仅建议内网穿透场景）
ALLOWED_HOSTS=localhost

# 1 = 干跑模式：不调用 LLM，返回固定样例响应（用于链路调试）
DRY_RUN=0

# 量规对访客开放开关：1 = 前端显示量规编辑页且读写接口可用；0 或不设 = 后台化（页面隐藏，读写接口 403）
# 对外部署请保持 0；本地调试需要看维度时再临时改 1
RUBRIC_PUBLIC=0
